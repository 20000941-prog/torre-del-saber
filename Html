  len:{intro:'Escucha bien: el lenguaje también tiene sus reglas.', lose:'Repasemos las reglas del lenguaje desde el inicio del capítulo.'},
  cie:{intro:'Observa el mundo que te rodea y responde con ciencia.', lose:'Tendrás que empezar este capítulo desde cero.'},
  soc:{intro:'Conoce tu historia y tu tierra antes de responder.', lose:'La historia no se olvida. Vuelve a intentarlo desde el inicio.'},
};

/* ---------------- Temporizador por pregunta (20s por puerta) ---------------- */
const QUESTION_SECONDS = 20;
let questionTimerHandle = null;
let answerLocked = false;

function stopQuestionTimer(){
  clearInterval(questionTimerHandle);
  questionTimerHandle = null;
}
function startQuestionTimer(ch){
  stopQuestionTimer();
  let timeLeft = QUESTION_SECONDS;
  const span = $('#q-timer'), chip = $('#q-timer-chip');
  if(span) span.textContent = timeLeft;
  questionTimerHandle = setInterval(()=>{
    timeLeft--;
    const s = $('#q-timer'), c = $('#q-timer-chip');
    if(s) s.textContent = Math.max(0, timeLeft);
    if(timeLeft<=5 && c) c.classList.add('urgent');
    if(timeLeft<=0){
      stopQuestionTimer();
      if(!answerLocked){
        answerLocked = true;
        resolveAnswer(false, ch);
      }
    }
  },1000);
}

function askQuestion(){
  answerLocked = false;
  const ch = chapterForFloor(state.floor);
  const q = generateQuestionFor(ch.key, state.tier);
  const hintAvailable = !state.hintUsedForChapter[ch.key];
  const hintLabel = '🔍 DESCARTAR PUERTA';
  screenEl.innerHTML = `
    <div class="panel">
      <div class="q-timer" id="q-timer-chip">⏱ <span id="q-timer">${QUESTION_SECONDS}</span>s</div>
      <div class="question-text">${q.text}</div>
      <div class="doors-row" id="q-doors"></div>
      <button class="hint-btn" id="hint-btn" ${hintAvailable ? '' : 'disabled'}>
        ${hintAvailable ? hintLabel : hintLabel+' (usado)'}
      </button>
    </div>`;

  const wrap = $('#q-doors');
  q.options.forEach(opt=>{
    const d = document.createElement('div');
    d.className = 'door';
    d.dataset.correct = String(opt)===String(q.correct) ? '1' : '0';
    d.innerHTML = `<div class="knob"></div><div class="label">${opt}</div>`;
    d.onclick = ()=>{
      if(answerLocked || d.classList.contains('discarded')) return;
      answerLocked = true;
      resolveAnswer(String(opt)===String(q.correct), ch);
    };
    wrap.appendChild(d);
  });
  $('#hint-btn').onclick = ()=>{
    if(!hintAvailable || answerLocked) return;
    state.hintUsedForChapter[ch.key] = true;
    const wrongDoors = Array.from(wrap.querySelectorAll('.door'))
      .filter(d=>d.dataset.correct==='0' && !d.classList.contains('discarded'));
    if(wrongDoors.length>0){
      const target = wrongDoors[Math.floor(Math.random()*wrongDoors.length)];
      target.classList.add('discarded');
    }
    const btn = $('#hint-btn');
    btn.disabled = true;
    btn.textContent = hintLabel+' (usado)';
  };
  startQuestionTimer(ch);
}

function flash(kind){
  const el = kind==='ok' ? $('#flash-correct') : $('#flash-wrong');
  el.classList.remove('on'); void el.offsetWidth; el.classList.add('on');
}

function resolveAnswer(isCorrect, ch){
  stopQuestionTimer();
  answerLocked = true;
  if(isCorrect){
    /* Racha: cada 3 aciertos seguidos suma +2 de daño "de racha", con tope aparte
       (STREAK_BONUS_CAP) para que la habilidad no vuelva irrelevante el resto del
       balance de combate. La racha en sí se reinicia al fallar, pero el bonus ya
       ganado se conserva (representa dominio acumulado del jugador). */
    state.streak++;
    if(state.streak % 3 === 0){
      state.streakBonusDamage = Math.min(STREAK_BONUS_CAP, (state.streakBonusDamage||0) + 2);
    }
    /* Puntos: sólo se ganan con respuestas correctas (+15, +25 si cae en una
       racha de 3+); las incorrectas ya no restan puntos. Son la ÚNICA moneda
       para comprar mejoras — se gastan exclusivamente en la tienda de la
       Zona de Descanso (ver renderShop). */
    state.points += (state.streak>=3 && state.streak%3===0) ? 25 : 15;
    updateHud();
    flash('ok');
    setTimeout(()=> onFloorCleared(ch), 700);
  } else {
    state.streak = 0;
    updateHud();
    flash('bad');
    state.mistakes++; updateHud();
    setTimeout(()=> onWrongAnswer(ch), 700);
  }
}

function onWrongAnswer(ch){
  /* Un mini jefe intercepta al jugador cada vez que falla una pregunta */
  triggerBossIntro(ch, false, true);
}

function onFloorCleared(ch){
  const completedFloor = state.floor;
  const isChapterEnd = completedFloor === ch.to;
  state.floor++;
  updateHud();
  if(isChapterEnd){
    /* El jefe de capítulo SIEMPRE debe aparecer, incluido el jefe final del piso 40 */
    return triggerBossIntro(ch, ch.key==='soc', false);
  }
  if(state.floor > 40){ return startEnding(); }
  /* Ya no hay recompensa gratuita al superar un piso: showFloorIntro sólo
     abre la Zona de Descanso (con su tienda) si el nuevo piso es inicio de
     sección; en cualquier otro caso pasa directo a la siguiente pregunta. */
  showFloorIntro();
}

/* ============================================================
   HABILIDADES / BUFFS (equilibradas: mejoran poco a poco, no derriban
   a un jefe en pocos golpes)
   ============================================================ */
/* ============================================================
   HABILIDADES / BUFFS
   ============================================================
   Balanceadas para crecer sin volverse absurdas en una corrida de 40 pisos:
   - GOLPE CERTERO ahora escala en % (no en plano) y respeta BASE_DAMAGE_CAP.
   - VITALIDAD tiene techo (8 vidas máx.) para no volver el combate trivial.
   - RAYO ARCANO deja de ser "inútil" si se repite: en vez de no hacer nada,
     reduce su enfriamiento (con un piso mínimo razonable). */
const ABILITY_POOL = [
  {id:'dmg', name:'GOLPE CERTERO', desc:'+12% de daño por disparo (con tope, no se vuelve absurdo).',
    apply:()=>{ state.abilities.damage = Math.min(BASE_DAMAGE_CAP, Math.round(state.abilities.damage*1.12)); }},
  {id:'multi', name:'RÁFAGA DOBLE', desc:'Disparas un proyectil adicional en abanico (máx. 3).',
    apply:()=>{ state.abilities.multishot = Math.min(3, state.abilities.multishot+1); }},
  {id:'hp', name:'VITALIDAD', desc:'+1 vida máxima (máx. 8).',
    apply:()=>{ state.abilities.maxHP = Math.min(8, state.abilities.maxHP+1); state.abilities.hp = state.abilities.maxHP; }},
  {id:'special', name:'RAYO ARCANO', desc:'Habilidad especial automática hacia tu puntero. Si ya la tienes, reduce su enfriamiento.',
    apply:()=>{
      if(!state.abilities.special){ state.abilities.special = {cooldown:3000, damage:16}; }
      else { state.abilities.special.cooldown = Math.max(1200, state.abilities.special.cooldown-400); }
    }},
];
/* ============================================================
   INTRO DE JEFE + COMBATE (canvas)
   ============================================================ */
function triggerBossIntro(ch, isFinal, isMini){
  $('#hud').classList.remove('show');
  const def = BOSS_DEFS[ch.key];
  const titleTxt = isFinal ? '¡EL GUARDIÁN FINAL DESPIERTA!' : (isMini ? '¡UN MINI GUARDIÁN TE INTERCEPTA!' : '¡UN GUARDIÁN APARECE!');
  const introTxt = isMini
    ? `Una versión menor de ${def.name} aprovecha tu error para ponerte a prueba.`
    : `${def.name} pone a prueba todo lo aprendido en ${ch.name}.`;
  screenEl.innerHTML = `
    <div class="panel">
      <h1 class="title" style="color:${def.color};font-size:${isFinal?'22px':'18px'};">${titleTxt}</h1>
      <div class="pixel-frame" id="boss-intro-frame" style="margin-bottom:16px;"></div>
      <p class="sub">${introTxt}</p>
      <button class="action" id="fight-btn">¡ENFRÉNTALO!</button>
    </div>`;
  $('#boss-intro-frame').appendChild(spriteToCanvas(def.sprite, isMini?5:8));
  $('#fight-btn').onclick = ()=> startBossBattle(ch, def, isFinal, isMini);
}

let bossState = null;
function startBossBattle(ch, def, isFinal, isMini){
  const canvas = $('#boss-canvas');
  canvas.style.display = 'block';
  canvas.width = window.innerWidth; canvas.height = window.innerHeight;
  const ctx = canvas.getContext('2d');
  ctx.imageSmoothingEnabled = false;

  screenEl.innerHTML = `
    <div class="bossbar-wrap">
      <div class="bossname">${def.name}${isMini?' (mini jefe)':''}</div>
      <div class="bossbar"><div class="bossbar-fill" id="boss-hp-fill"></div></div>
    </div>
    <div class="playerhp" id="player-hp"></div>
    <div class="boss-hint">MUÉVETE: WASD/FLECHAS · APUNTA CON EL MOUSE · CLIC O ESPACIO PARA ATACAR</div>
  `;

  state.abilities.hp = state.abilities.maxHP;
  const hp = isMini ? def.miniHp : def.hp;
  const scale = isMini ? 6 : 9;
  bossState = {
    ch, def, ctx, canvas, isFinal, isMini, scale,
    hp, maxHp: hp,
    playerHP: state.abilities.hp,
    bullets:[], bossBullets:[],
    mouse:{x:canvas.width/2, y:canvas.height/2},
    keys:{},
    timers:{}, lastPlayerShot:0, lastSpecial:0,
    bx:canvas.width/2, by:150,
    px:canvas.width/2, py:canvas.height-70,
    /* Estado nuevo para IA de jefes y feedback de combate: */
    telegraphs:[],          // avisos visuales de ataques de área/embestida pendientes
    minions:[],             // secuaces invocados (ahora dañables, con vida propia)
    floatingTexts:[],       // números de daño flotantes (legibilidad del golpe)
    hitMarkers:[],          // marcador "✕" en el punto de impacto (feedback estilo shooter)
    recentHits:[],          // marcas de tiempo de golpes recientes del jugador (contraataque)
    charging:false, dashFromX:0, dashToX:0,
    playerInvulnUntil:0,    // i-frames: evita perder varias vidas por una ráfaga simultánea
    shakeUntil:0, shakeMag:0, // sacudida de cámara al recibir daño (feedback de impacto)
    over:false,
  };
  renderPlayerHP();

  canvas.onmousemove = e=>{ bossState.mouse.x=e.clientX; bossState.mouse.y=e.clientY; };
  canvas.onclick = ()=> playerShoot();
  const MOVE_KEYS = ['ArrowUp','ArrowDown','ArrowLeft','ArrowRight','KeyW','KeyA','KeyS','KeyD','Space'];
  window.onkeydown = e=>{
    if(MOVE_KEYS.includes(e.code)) e.preventDefault();
    if(e.code==='Space'){ playerShoot(); return; }
    bossState.keys[e.code] = true;
  };
  window.onkeyup = e=>{ bossState.keys[e.code] = false; };

  requestAnimationFrame(bossLoop);
}

function renderPlayerHP(){
  const wrap = $('#player-hp'); if(!wrap) return;
  wrap.innerHTML='';
  for(let i=0;i<state.abilities.maxHP;i++){
    const s = document.createElement('span');
    s.textContent = i < bossState.playerHP ? '❤' : '🖤';
    s.style.fontSize='20px';
    wrap.appendChild(s);
  }
}

/* Movimiento libre del avatar del jugador dentro de la mitad inferior de la arena */
function updatePlayerMovement(b){
  const speed = 5.2;
  let dx=0, dy=0;
  if(b.keys['KeyA']||b.keys['ArrowLeft']) dx -= 1;
  if(b.keys['KeyD']||b.keys['ArrowRight']) dx += 1;
  if(b.keys['KeyW']||b.keys['ArrowUp']) dy -= 1;
  if(b.keys['KeyS']||b.keys['ArrowDown']) dy += 1;
  if(dx!==0 && dy!==0){ dx*=0.7071; dy*=0.7071; }
  b.px = Math.max(40, Math.min(b.canvas.width-40, b.px+dx*speed));
  const minY = b.canvas.height*0.5, maxY = b.canvas.height-40;
  b.py = Math.max(minY, Math.min(maxY, b.py+dy*speed));
}

function playerShoot(){
  if(!bossState || bossState.over) return;
  const cfg = PLAYER_ATTACK[state.character.id];
  const now = performance.now();
  if(now - bossState.lastPlayerShot < cfg.cooldown) return;
  bossState.lastPlayerShot = now;
  const originX = bossState.px, originY = bossState.py;
  const n = state.abilities.multishot;
  for(let i=0;i<n;i++){
    const spread = (i-(n-1)/2)*0.12;
    const angle = Math.atan2(bossState.mouse.y-originY, bossState.mouse.x-originX)+spread;
    const {dmg, isCrit} = computePlayerDamage(cfg);
    bossState.bullets.push({
      x:originX, y:originY,
      vx:Math.cos(angle)*cfg.speed, vy:Math.sin(angle)*cfg.speed,
      dmg, isCrit,
      size: isCrit ? cfg.size*1.5 : cfg.size,   // el crítico se ve más grande: feedback legible, no oculto
      color: isCrit ? '#fff2b0' : cfg.color,
    });
  }
}

const PLAYER_HURT_RADIUS = 15;  // hurtbox base del jugador, antes de sumar el tamaño del proyectil
const PLAYER_IFRAMES_MS = 700;  // i-frames tras recibir un golpe: un impacto = un daño,
                                 // no una vida entera perdida por una ráfaga simultánea (bug corregido)

function updateBossBullets(t, ctx){
  const b = bossState;
  const newOnes = [];
  const invulnerable = t < (b.playerInvulnUntil||0);
  b.bossBullets = b.bossBullets.filter(bullet=>{
    if(bullet.homing){
      const desired = Math.atan2(b.py-bullet.y, b.px-bullet.x);
      const cur = Math.atan2(bullet.vy,bullet.vx);
      let diff = desired-cur;
      while(diff>Math.PI) diff-=2*Math.PI;
      while(diff<-Math.PI) diff+=2*Math.PI;
      const turn = Math.max(-0.06,Math.min(0.06,diff));
      const speed = Math.hypot(bullet.vx,bullet.vy);
      const newAngle = cur+turn;
      bullet.vx = Math.cos(newAngle)*speed; bullet.vy = Math.sin(newAngle)*speed;
    }
    bullet.x += bullet.vx; bullet.y += bullet.vy;
    if(bullet.splitIn!=null && !bullet.splitDone && (t-bullet.spawnTime)>bullet.splitIn){
      bullet.splitDone = true;
      const ang = Math.atan2(bullet.vy,bullet.vx);
      const speed = Math.hypot(bullet.vx,bullet.vy);
      [-0.4,0.4].forEach(off=>{
        newOnes.push({x:bullet.x,y:bullet.y,vx:Math.cos(ang+off)*speed,vy:Math.sin(ang+off)*speed,color:bullet.color,size:bullet.size*0.8,spawnTime:t});
      });
      return false;
    }
    ctx.fillStyle = bullet.color;
    ctx.fillRect(bullet.x-bullet.size/2, bullet.y-bullet.size/2, bullet.size, bullet.size);
    if(!invulnerable){
      const dx = bullet.x-b.px, dy = bullet.y-b.py;
      const hitDist = PLAYER_HURT_RADIUS + bullet.size/2; // hitbox proporcional al tamaño visible: justa y legible
      if(Math.hypot(dx,dy) < hitDist){
        b.playerHP--; renderPlayerHP();
        b.playerInvulnUntil = t + PLAYER_IFRAMES_MS;
        /* Sacudida de cámara breve al recibir daño — feedback de impacto
           inspirado en el "judder" del video de referencia al ser golpeado. */
        b.shakeUntil = t + 220; b.shakeMag = 7;
        return false;
      }
    }
    return bullet.x>-30 && bullet.x<b.canvas.width+30 && bullet.y>-30 && bullet.y<b.canvas.height+30;
  });
  b.bossBullets.push(...newOnes);
}

/* Marcador de impacto "✕" en el punto donde un disparo del jugador conecta,
   estilo shooter (fiel al destello rojo alrededor de la mira del video de
   referencia al acertar un golpe). Puramente visual, dura ~220ms. */
function pushHitMarker(b, x, y){
  b.hitMarkers.push({x, y, born:performance.now()});
}
function drawHitMarkers(b, ctx, t){
  b.hitMarkers = (b.hitMarkers||[]).filter(hm=>{
    const age = t-hm.born;
    if(age>220) return false;
    const p = age/220;
    ctx.strokeStyle = `rgba(255,90,90,${1-p})`;
    ctx.lineWidth = 2;
    const s = 6+p*6, o = 4+p*4;
    [[-1,-1],[1,-1],[-1,1],[1,1]].forEach(([dx,dy])=>{
      ctx.beginPath();
      ctx.moveTo(hm.x+dx*o, hm.y+dy*o);
      ctx.lineTo(hm.x+dx*(o+s), hm.y+dy*(o+s));
      ctx.stroke();
    });
    return true;
  });
}

/* Dibuja los avisos de ataque de área/embestida (círculo pulsante que crece).
   Es la parte visual de telegraphedRingBurst/chargeDash: sin esto los ataques
   telegrafiados dejarían de sentirse justos. */
function drawTelegraphs(b, ctx, t){
  b.telegraphs = (b.telegraphs||[]).filter(tg=>{
    const age = t-tg.start;
    if(age>tg.duration) return false;
    const r = 30 + (age/tg.duration)*70;
    ctx.globalAlpha = 0.55 - (age/tg.duration)*0.35;
    ctx.strokeStyle = tg.color;
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.arc(tg.x(), tg.y(), r, 0, Math.PI*2);
    ctx.stroke();
    ctx.globalAlpha = 1;
    return true;
  });
}

/* Números de daño flotantes: feedback inmediato y legible de cuánto golpeó cada
   disparo (y si fue crítico), en vez de que el daño sea una cifra invisible. */
function pushFloatingText(b, x, y, dmg, isCrit){
  b.floatingTexts.push({x, y, text:String(dmg)+(isCrit?'!':''), isCrit, born:performance.now()});
}
function drawFloatingTexts(b, ctx, t){
  b.floatingTexts = (b.floatingTexts||[]).filter(ft=>{
    const age = t-ft.born;
    if(age>700) return false;
    ctx.globalAlpha = 1-(age/700);
    ctx.fillStyle = ft.isCrit ? '#ffe27a' : '#ffffff';
    ctx.font = (ft.isCrit ? 'bold 16px' : '12px')+' monospace';
    ctx.fillText(ft.text, ft.x-8, ft.y-(age/700)*22);
    ctx.globalAlpha = 1;
    return true;
  });
}

function bossLoop(t){
  if(!bossState) return;
  const b = bossState;
  const {ctx, canvas} = b;
  ctx.clearRect(0,0,canvas.width,canvas.height);

  /* Sacudida de cámara: desplaza TODO lo que se dibuja este frame (no sólo el
     sprite del jefe), por eso se aplica con save/translate al inicio y se
     cierra con restore al final del frame. */
  ctx.save();
  if(t < (b.shakeUntil||0)){
    const decay = (b.shakeUntil-t)/220;
    ctx.translate((Math.random()-0.5)*b.shakeMag*decay, (Math.random()-0.5)*b.shakeMag*decay);
  }

  updatePlayerMovement(b);

  /* El jefe sólo controla su propia X libremente durante una embestida (chargeDash);
     el resto del tiempo flota en el centro con un leve balanceo. */
  if(!b.charging){
    b.bx = canvas.width/2;
  }
  b.by = 130 + Math.sin(t/500)*10;

  drawTelegraphs(b, ctx, t);

  const scale = b.scale;
  const shakeOffset = b.charging ? (Math.random()-0.5)*8 : 0; // sacudida cosmética durante el telegraph de embestida
  drawSprite(ctx, b.def.sprite, b.bx-8*scale+shakeOffset, b.by-5*scale, scale);

  b.def.attack(t, b);
  if(b.def.counter) maybeCounter(b, t);
  updateBossBullets(t, ctx);
  updateMinions(b, t, ctx);

  b.bullets = b.bullets.filter(bullet=>{
    bullet.x += bullet.vx; bullet.y += bullet.vy;
    ctx.fillStyle = bullet.color;
    ctx.fillRect(bullet.x-bullet.size/2, bullet.y-bullet.size/2, bullet.size, bullet.size);

    /* Los secuaces se comprueban ANTES que el jefe: al orbitar por delante,
       actúan como escudos que hay que limpiar, dando al combate el ritmo de
       "despejar el enjambre y luego castigar al jefe" del video de referencia. */
    const hitMinion = b.minions.find(m=> Math.hypot(bullet.x-m.x, bullet.y-m.y) < 10 + bullet.size/2);
    if(hitMinion){
      hitMinion.hp -= bullet.dmg;
      pushFloatingText(b, bullet.x, bullet.y, bullet.dmg, bullet.isCrit);
      pushHitMarker(b, bullet.x, bullet.y);
      return false;
    }

    const dx = bullet.x-b.bx, dy = bullet.y-b.by;
    const bossHurtRadius = scale*6.2 + bullet.size/2; // hitbox del jefe proporcional al tamaño del disparo
    if(Math.hypot(dx,dy) < bossHurtRadius){
      b.hp -= bullet.dmg;
      pushFloatingText(b, bullet.x, bullet.y, bullet.dmg, bullet.isCrit);
      pushHitMarker(b, bullet.x, bullet.y);
      registerPlayerHit(b, t);
      const fill = $('#boss-hp-fill');
      if(fill) fill.style.width = Math.max(0,(b.hp/b.maxHp*100))+'%';
      return false;
    }
    return bullet.x>-20 && bullet.x<canvas.width+20 && bullet.y>-20 && bullet.y<canvas.height+20;
  });

  if(state.abilities.special){
    if(t - b.lastSpecial > state.abilities.special.cooldown){
      b.lastSpecial = t;
      const angle = Math.atan2(b.mouse.y-b.py, b.mouse.x-b.px);
      b.bullets.push({x:b.px,y:b.py,vx:Math.cos(angle)*11,vy:Math.sin(angle)*11,dmg:state.abilities.special.damage,size:9,color:'#c9a8ff'});
    }
  }

  drawFloatingTexts(b, ctx, t);
  drawHitMarkers(b, ctx, t);

  ctx.strokeStyle = '#f4e9d8'; ctx.lineWidth = 2;
  ctx.strokeRect(b.mouse.x-10, b.mouse.y-10, 20, 20);

  /* Parpadeo del jugador mientras dura la invulnerabilidad (i-frames): feedback
     visual claro de que ese golpe no le va a hacer daño de nuevo. */
  const flickering = t < (b.playerInvulnUntil||0) && Math.floor(t/80)%2===0;
  ctx.globalAlpha = flickering ? 0.35 : 1;
  drawSprite(ctx, state.character.sprite, b.px-8*4, b.py-9*4, 4);
  ctx.globalAlpha = 1;

  ctx.restore(); // cierra el translate de la sacudida de cámara

  if(b.hp<=0 && !b.over){ b.over=true; return endBoss(true); }
  if(b.playerHP<=0 && !b.over){ b.over=true; return endBoss(false); }

  requestAnimationFrame(bossLoop);
}

function endBoss(won){
  const ch = bossState.ch, isFinal = bossState.isFinal, isMini = bossState.isMini;
  $('#boss-canvas').style.display='none';
  window.onkeydown = null; window.onkeyup = null;

  if(isMini){
    if(won){
      screenEl.innerHTML = `
        <div class="panel">
          <h1 class="title" style="color:${ch.color};font-size:17px;">¡MINI GUARDIÁN VENCIDO!</h1>
          <p class="sub">Continúa tu ascenso. Guarda tus puntos: solo podrás cambiarlos por mejoras en la próxima Zona de Descanso.</p>
          <button class="action" id="continue-btn">CONTINUAR</button>
        </div>`;
      $('#continue-btn').onclick = ()=>{ $('#hud').classList.add('show'); askQuestion(); };
    } else {
      state.floor = state.checkpoint;
      screenEl.innerHTML = `
        <div class="panel">
          <h1 class="title" style="color:${ch.color};font-size:17px;">"${GUIDE_LINES[ch.key].lose}"</h1>
          <p class="sub">Vuelves al punto de control: piso ${state.checkpoint}.</p>
          <button class="action" id="continue-btn">REINTENTAR</button>
        </div>`;
      $('#continue-btn').onclick = ()=>{ $('#hud').classList.add('show'); showFloorIntro(); };
    }
    return;
  }

  if(won){
    if(isFinal){
      screenEl.innerHTML = `
        <div class="panel">
          <h1 class="title" style="color:${ch.color};font-size:20px;">¡COSMIC LORD HA CAÍDO!</h1>
          <p class="sub">La Torre del Saber comienza a temblar...</p>
          <button class="action" id="continue-btn">SALIR DE LA TORRE</button>
        </div>`;
      $('#continue-btn').onclick = ()=> startEnding();
      return;
    }
    state.checkpoint = state.floor;
    screenEl.innerHTML = `
      <div class="panel">
        <h1 class="title" style="color:${ch.color};font-size:18px;">¡GUARDIÁN VENCIDO!</h1>
        <p class="sub">El camino hacia ${chapterForFloor(state.floor).name} está abierto.</p>
        <button class="action" id="continue-btn">CONTINUAR</button>
      </div>`;
    $('#continue-btn').onclick = ()=>{ $('#hud').classList.add('show'); showFloorIntro(true); };
  } else {
    state.floor = ch.from;
    state.checkpoint = ch.from;
    screenEl.innerHTML = `
      <div class="panel">
        <h1 class="title" style="color:${ch.color};font-size:18px;">"${GUIDE_LINES[ch.key].lose}"</h1>
        <p class="sub">Deberás rehacer el capítulo de ${ch.name} desde el piso ${ch.from}.</p>
        <button class="action" id="continue-btn">REINTENTAR</button>
      </div>`;
    $('#continue-btn').onclick = ()=>{ $('#hud').classList.add('show'); showFloorIntro(); };
  }
}

/* ============================================================
   MENÚ DE PAUSA — salir sin reiniciar el programa
   ============================================================ */
function pauseTimer(){
  clearInterval(state.timerHandle);
  state.pausedAt = Date.now();
}
function resumeTimerKeep(){
  if(state.pausedAt){ state.startTime += (Date.now()-state.pausedAt); state.pausedAt = null; }
  clearInterval(state.timerHandle);
  state.timerHandle = setInterval(()=>{ $('#hud-time').textContent = fmtTime(Date.now()-state.startTime); },500);
}

function openPauseMenu(){
  if(document.getElementById('pause-overlay')) return;
  if($('#boss-canvas').style.display==='block') return; /* no pausar en combate */
  stopQuestionTimer(); /* evita que el reloj de 20s siga corriendo mientras el menú está abierto */
  pauseTimer();
  const overlay = document.createElement('div');
  overlay.id = 'pause-overlay';
  overlay.style.cssText = 'position:fixed;inset:0;z-index:60;background:rgba(10,7,6,0.88);display:flex;align-items:center;justify-content:center;';
  overlay.innerHTML = `
    <div class="panel">
      <h1 class="title" style="font-size:20px;">PAUSA</h1>
      <p class="sub">Piso ${state.floor} · Errores ${state.mistakes} · Tiempo ${fmtTime(Date.now()-state.startTime)}</p>
      <div class="cards">
        <div class="card" id="resume-card"><h3>REANUDAR</h3><p>Vuelve a la partida donde la dejaste.</p></div>
        <div class="card" id="change-cycle-card"><h3>CAMBIAR CICLO/GRADO</h3><p>Elige un nuevo ciclo y grado sin cerrar el juego.</p></div>
        <div class="card" id="change-char-card"><h3>CAMBIAR HÉROE</h3><p>Vuelve a elegir tu personaje desde cero.</p></div>
      </div>
    </div>`;
  document.getElementById('app').appendChild(overlay);
  $('#resume-card').onclick = ()=>{ overlay.remove(); resumeTimerKeep(); };
  $('#change-cycle-card').onclick = ()=>{ overlay.remove(); clearInterval(state.timerHandle); $('#hud').classList.remove('show'); showCycleSelect(); };
  $('#change-char-card').onclick = ()=>{ overlay.remove(); clearInterval(state.timerHandle); $('#hud').classList.remove('show'); showCharacterSelect(); };
}

document.addEventListener('keydown', e=>{
  if(e.code==='Escape' && state.character && $('#hud').classList.contains('show')){
    if(document.getElementById('pause-overlay')){ document.getElementById('pause-overlay').remove(); resumeTimerKeep(); }
    else openPauseMenu();
  }
});

/* ============================================================
   FINAL: cinemática de escape — castillo medieval pixelado con
   fondo animado (interior oscuro -> portón -> exterior iluminado)
   ============================================================ */
let endingAnim = null;
function initEndingBg(canvas){
  const ctx = canvas.getContext('2d');
  ctx.imageSmoothingEnabled = false;
  const W = 220, H = 124;
  canvas.width = W; canvas.height = H;
  const clouds = [];
  for(let i=0;i<5;i++){
    clouds.push({x:Math.random()*W, y:12+Math.random()*30, speed:0.12+Math.random()*0.18});
  }
  const doorX = Math.round(W*0.56);
  endingAnim = {ctx, W, H, clouds, doorX, start:performance.now(), running:true};
  requestAnimationFrame(endingLoop);
}

function endingLoop(t){
  if(!endingAnim || !endingAnim.running) return;
  const {ctx, W, H, clouds, doorX, start} = endingAnim;
  const progress = Math.min(1, (t-start)/3400);
  ctx.clearRect(0,0,W,H);

  /* --- Exterior: cielo, sol, colinas, suelo (se dibuja en toda la escena) --- */
  const skyTop = lerpColor('#2a2020','#8fd0ec', progress);
  const skyBot = lerpColor('#2a2020','#ffe9c2', progress);
  const grad = ctx.createLinearGradient(0,0,0,H);
  grad.addColorStop(0, skyTop); grad.addColorStop(1, skyBot);
  ctx.fillStyle = grad;
  ctx.fillRect(0,0,W,H);

  const sunY = 46 - progress*22;
  ctx.fillStyle = lerpColor('#2a2020','#fff2c2', progress);
  ctx.fillRect(W*0.80-9, sunY-9, 18, 18);

  ctx.fillStyle = 'rgba(255,255,255,'+(0.15+0.5*progress)+')';
  clouds.forEach(c=>{
    c.x += c.speed;
    if(c.x > W+24) c.x = -24;
    for(let i=0;i<3;i++){ ctx.fillRect(c.x+i*7, c.y+(i%2)*3, 8, 5); }
  });

  ctx.fillStyle = lerpColor('#2a2020','#4d7a3f', progress);
  for(let hx=doorX-20; hx<W; hx+=26){
    ctx.beginPath();
    ctx.moveTo(hx-14, H-16);
    ctx.lineTo(hx, H-30);
    ctx.lineTo(hx+14, H-16);
    ctx.fill();
  }
  ctx.fillStyle = lerpColor('#2a2020','#6b9a4e', progress);
  ctx.fillRect(0, H-14, W, 14);
  ctx.fillStyle = lerpColor('#241c1a','#4f7c3a', progress);
  for(let gx=0; gx<W; gx+=6){ ctx.fillRect(gx, H-14, 3, 3); }

  /* --- Interior del castillo: muros de piedra oscuros a la izquierda del portón --- */
  ctx.save();
  ctx.beginPath();
  ctx.rect(0,0,doorX,H);
  ctx.clip();
  ctx.fillStyle = '#1c1512';
  ctx.fillRect(0,0,doorX,H);
  const rows = Math.ceil(H/7);
  for(let ry=0; ry<rows; ry++){
    const y = ry*7;
    const offset = (ry%2===0)?0:4;
    for(let x=-4; x<doorX; x+=8){
      const seed = (x*7+ry*13)%23;
      ctx.fillStyle = seed<11 ? '#332822' : (seed<18 ? '#40312a' : '#241b17');
      ctx.fillRect(x+offset, y, 7, 5);
    }
  }
  /* antorchas parpadeantes */
  const flick = Math.sin(t/120)*0.4+0.6;
  [[14, H*0.42],[doorX-26, H*0.62]].forEach(pos=>{
    ctx.fillStyle = '#2a1c13';
    ctx.fillRect(pos[0]-2, pos[1], 4, 14);
    ctx.fillStyle = `rgba(244,169,74,${flick})`;
    ctx.fillRect(pos[0]-4, pos[1]-8, 8, 9);
    ctx.fillStyle = `rgba(255,230,150,${flick*0.8})`;
    ctx.fillRect(pos[0]-2, pos[1]-6, 4, 5);
  });
  /* haz de luz que entra por el portón conforme se acerca la salida */
  const lightGrad = ctx.createLinearGradient(doorX-46,0,doorX,0);
  lightGrad.addColorStop(0,'rgba(255,220,150,0)');
  lightGrad.addColorStop(1,`rgba(255,220,150,${0.25*progress})`);
  ctx.fillStyle = lightGrad;
  ctx.fillRect(doorX-46,0,46,H);
  ctx.restore();

  /* --- Marco del portón (piedra clara) --- */
  ctx.fillStyle = '#5a4636';
  ctx.fillRect(doorX-6, H*0.16, 6, H*0.84);
  ctx.fillRect(doorX+2, 0, 0, 0); /* no-op keep structure simple */
  ctx.fillStyle = '#6b5643';
  ctx.fillRect(doorX-6, H*0.14, 12, 6);

  requestAnimationFrame(endingLoop);
}

function startEnding(){
  clearInterval(state.timerHandle);
  $('#hud').classList.remove('show');
  const elapsed = Date.now()-state.startTime;
  screenEl.innerHTML = '';
  const cs = document.createElement('div');
  cs.id='cutscene';
  cs.innerHTML = `
    <canvas id="ending-canvas"></canvas>
    <div class="runner" id="runner"></div>
    <div class="stats-box" id="stats-box">
      <h1>¡ESCAPASTE DE<br>LA TORRE DEL SABER!</h1>
      <div class="stat">⏱ TIEMPO TOTAL: ${fmtTime(elapsed)}</div>
      <div class="stat">❌ RESPUESTAS INCORRECTAS: ${state.mistakes}</div>
      <button class="action" id="restart-btn" style="margin-top:18px;">JUGAR DE NUEVO</button>
    </div>`;
  document.getElementById('app').appendChild(cs);
  document.getElementById('runner').appendChild(spriteToCanvas(state.character.sprite, 5));
  initEndingBg(document.getElementById('ending-canvas'));
  requestAnimationFrame(()=>{
    setTimeout(()=>{
      const r = document.getElementById('runner');
      r.style.left = '63%';
      r.style.bottom = '13%';
    }, 250);
    setTimeout(()=>{ $('#stats-box').classList.add('show'); }, 3200);
  });
  setTimeout(()=>{
    const btn = document.getElementById('restart-btn');
    if(btn) btn.onclick = ()=>{ endingAnim && (endingAnim.running=false); cs.remove(); resetAll(); };
  }, 200);
}

function resetAll(){
  state.character=null; state.grade=null; state.tier=1;
  state.floor=1; state.checkpoint=1; state.mistakes=0;
  state.pausedAt=null;
  state.usedQuestions={}; state.lastQuestionKey={mat:null, len:null, cie:null, soc:null};
  state.streak=0; state.streakBonusDamage=0; state.hintUsedForChapter={};
  state.points=0; state.shopPurchases={};
  state.abilities={damage:10,multishot:1,maxHP:3,hp:3,special:null};
  showCharacterSelect();
}

/* ---------------- Inicio ---------------- */
window.addEventListener('resize', ()=>{
  if(bossState && $('#boss-canvas').style.display==='block'){
    bossState.canvas.width = window.innerWidth; bossState.canvas.height = window.innerHeight;
  }
});
showCharacterSelect();
</script>
