/* Tienda de la zona de descanso: gasta los puntos ganados con respuestas
   correctas (y perdidos con las incorrectas) para comprar las mismas
   mejoras que se ofrecen gratis al superar un piso. El precio de cada
   mejora sube un poco cada vez que se compra (state.shopPurchases), para
   que no sea rentable comprar la misma decenas de veces seguidas. */
function shopPrice(id){
  const base = SHOP_BASE_PRICE[id] || 50;
  const bought = state.shopPurchases[id] || 0;
  return Math.round(base * (1 + bought*0.6));
}
function renderShop(){
  const grid = $('#shop-grid');
  if(!grid) return;
  grid.innerHTML = '';
  ABILITY_POOL.forEach(ab=>{
    const price = shopPrice(ab.id);
    const canAfford = state.points >= price;
    const card = document.createElement('div');
    card.className = 'shop-card';
    card.innerHTML = `
      <div class="shop-card-name">${ab.name}</div>
      <div class="shop-card-desc">${ab.desc}</div>
      <button class="action shop-buy-btn" ${canAfford ? '' : 'disabled'}>⭐ ${price}</button>`;
    card.querySelector('.shop-buy-btn').onclick = ()=>{
      if(state.points < price) return;
      state.points -= price;
      state.shopPurchases[ab.id] = (state.shopPurchases[ab.id]||0) + 1;
      ab.apply();
      updateHud();
      const pointsLabel = $('#shop-points');
      if(pointsLabel) pointsLabel.textContent = '⭐ '+state.points;
      renderShop();
    };
    grid.appendChild(card);
  });
}

/* Pequeña escena decorativa de fogata para la zona de descanso: brasas
   flotando con el color del capítulo actual, dibujadas en un canvas propio
   de baja resolución (mismo estilo pixel art que el resto del juego). La
   animación se detiene sola en cuanto el canvas deja de estar en el DOM. */
function renderRestScene(canvas, ch){
  if(!canvas) return;
  const ctx = canvas.getContext('2d');
  ctx.imageSmoothingEnabled = false;
  const W = canvas.width, H = canvas.height;
  const embers = [];
  for(let i=0;i<14;i++){
    embers.push({x:W/2+(Math.random()-0.5)*40, y:H-10-Math.random()*20, vy:-0.3-Math.random()*0.4, life:Math.random()*100, size:1+Math.random()*2});
  }
  function frame(){
    if(!document.body.contains(canvas)) return; // la pantalla cambió: detener la animación
    ctx.clearRect(0,0,W,H);
    // silueta de suelo y campamento
    ctx.fillStyle = 'rgba(0,0,0,0.35)';
    ctx.fillRect(0,H-8,W,8);
    ctx.fillStyle = '#2a1c12';
    ctx.fillRect(W/2-3,H-24,3,16); ctx.fillRect(W/2+1,H-24,3,16);
    // fogata
    ctx.fillStyle = ch.color;
    ctx.globalAlpha = 0.85;
    ctx.beginPath(); ctx.moveTo(W/2-6,H-10); ctx.lineTo(W/2,H-22); ctx.lineTo(W/2+6,H-10); ctx.fill();
    ctx.globalAlpha = 1;
    embers.forEach(e=>{
      e.y += e.vy; e.life -= 1;
      if(e.life<=0 || e.y<0){ e.x=W/2+(Math.random()-0.5)*40; e.y=H-10; e.life=90+Math.random()*40; }
      ctx.fillStyle = ch.color;
      ctx.globalAlpha = Math.max(0, e.life/130);
      ctx.fillRect(e.x, e.y, e.size, e.size);
      ctx.globalAlpha = 1;
    });
    requestAnimationFrame(frame);
  }
  frame();
}

