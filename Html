/* ============================================================
   SISTEMA DE DAÑO DEL JUGADOR
   ============================================================
   Una sola fórmula, fácil de auditar: daño = (base con tope + bonus de
   racha con tope + bonus de personaje), con probabilidad de crítico.
   Los topes (CAP) existen para que las mejoras acumuladas a lo largo de
   40 pisos no vuelvan trivial a los jefes tardíos (evita el "OP" sin
   quitarle la sensación de progreso). */
const CRIT_CHANCE = 0.15;       // 15% de probabilidad de golpe crítico
const CRIT_MULTIPLIER = 1.75;   // golpe fuerte pero legible: nunca un one-shot injusto
const STREAK_BONUS_CAP = 20;    // tope del bonus de daño ganado por racha de aciertos
const BASE_DAMAGE_CAP = 140;    // tope del daño base ganado por mejoras de piso

function computePlayerDamage(cfg){
  const base = Math.min(BASE_DAMAGE_CAP, state.abilities.damage) + Math.min(STREAK_BONUS_CAP, state.streakBonusDamage||0);
  const withChar = base + cfg.dmgBonus;
  const isCrit = Math.random() < CRIT_CHANCE;
  const dmg = Math.round(isCrit ? withChar*CRIT_MULTIPLIER : withChar);
  return {dmg, isCrit};
}

