/* ============================================================
   SISTEMA VISUAL DINÁMICO — fondo del castillo + cielo + partículas
   ============================================================
   Cada capítulo tiene su propia paleta (muros, cielo, partículas
   ambientales) y el juego interpola entre paletas conforme el jugador
   avanza de piso, en vez de saltar bruscamente al cambiar de capítulo:
   - MATEMÁTICAS: místico / púrpura arcano, chispas flotantes.
   - LENGUAJE: sereno / esmeralda-teal, hojas y páginas flotando.
   - CIENCIAS: vivo / verde lima, motas de luz bioluminiscente.
   - SOCIALES: cálido / épico, brasas y destellos anaranjados. */
const CHAPTER_PALETTES = {
  mat:{ wallLo:'#241a38', wallMid:'#33244c', wallHi:'#453262',
        sky:['#241a45','#3a2566','#6f3866','#a8455c','#d9603f'],
        particle:'#c9a8ff', shape:'spark' },
  len:{ wallLo:'#102c24', wallMid:'#164237', wallHi:'#1d5c4b',
        sky:['#0b4a3d','#146856','#1f9d84','#5cc9a8','#bfe9da'],
        particle:'#9df0dd', shape:'leaf' },
  cie:{ wallLo:'#1c3418', wallMid:'#2a5222', wallHi:'#397230',
        sky:['#123018','#1f5a26','#3c9a52','#79c96a','#c8f59b'],
        particle:'#c8f59b', shape:'spark' },
  soc:{ wallLo:'#3a2314', wallMid:'#5a331a', wallHi:'#7a4620',
        sky:['#3a1a4a','#6a2f4a','#d9603f','#e8794a','#ffd9a0'],
        particle:'#ffd9a0', shape:'ember' },
};

function hexToRgb(hex){ const h=hex.replace('#',''); return [parseInt(h.substr(0,2),16), parseInt(h.substr(2,2),16), parseInt(h.substr(4,2),16)]; }
function rgbToHex(r,g,b){ return '#'+[r,g,b].map(v=>Math.max(0,Math.min(255,Math.round(v))).toString(16).padStart(2,'0')).join(''); }
function lerpColor(a,b,t){ const A=hexToRgb(a),B=hexToRgb(b); return rgbToHex(A[0]+(B[0]-A[0])*t, A[1]+(B[1]-A[1])*t, A[2]+(B[2]-A[2])*t); }

const bgCanvas = document.getElementById('bg-canvas');
const bgCtx = bgCanvas.getContext('2d');
const BG_W = 240, BG_H = 135;
bgCanvas.width = BG_W; bgCanvas.height = BG_H;
bgCtx.imageSmoothingEnabled = false;

let bgParticles = [];
function spawnParticle(pal){
  const shape = pal.shape;
  if(shape==='leaf'){
    bgParticles.push({x:-4, y:Math.random()*BG_H*0.55, vx:0.3+Math.random()*0.35, life:0, maxLife:220+Math.random()*100, color:pal.particle, size:1.5+Math.random()*1.5, sway:Math.random()*Math.PI*2});
  } else if(shape==='ember'){
    bgParticles.push({x:Math.random()*BG_W, y:BG_H+4, vx:(Math.random()-0.5)*0.25, vy:-0.35-Math.random()*0.6, life:0, maxLife:120+Math.random()*80, color:pal.particle, size:1+Math.random()*2});
  } else {
    bgParticles.push({x:Math.random()*BG_W, y:BG_H+4, vx:(Math.random()-0.5)*0.2, vy:-0.3-Math.random()*0.45, life:0, maxLife:150+Math.random()*90, color:pal.particle, size:1+Math.random()});
  }
}
function updateParticles(pal){
  if(bgParticles.length<24 && Math.random()<0.35) spawnParticle(pal);
  bgParticles = bgParticles.filter(p=>{
    p.life++;
    if(p.sway!==undefined){ p.x += p.vx; p.y += Math.sin(p.life*0.05+p.sway)*0.15; }
    else { p.x += p.vx; p.y += p.vy; }
    bgCtx.fillStyle = p.color;
    bgCtx.globalAlpha = Math.max(0, 1-p.life/p.maxLife) * 0.85;
    bgCtx.fillRect(p.x, p.y, p.size, p.size);
    bgCtx.globalAlpha = 1;
    return p.life<p.maxLife && p.x>-10 && p.x<BG_W+10 && p.y>-10 && p.y<BG_H+10;
  });
}

function drawCastleBG(t){
  const idx = Math.max(0, chapterIndex(state.floor));
  const ch = CHAPTERS[idx];
  const pal = CHAPTER_PALETTES[ch.key];
  bgCtx.clearRect(0,0,BG_W,BG_H);
  // muros de piedra en bloques, teñidos con la paleta del capítulo actual
  const rows = Math.ceil(BG_H/6);
  for(let ry=0; ry<rows; ry++){
    const y = ry*6;
    const offset = (ry%2===0)?0:4;
    for(let x=-4; x<BG_W; x+=8){
      const seed = (x*7+ry*13+state.floor*3) % 23;
      bgCtx.fillStyle = seed<11 ? pal.wallLo : (seed<18 ? pal.wallMid : pal.wallHi);
      bgCtx.fillRect(x+offset, y, 7, 5);
    }
  }
  bgCtx.fillStyle = 'rgba(0,0,0,0.25)';
  for(let ry=0; ry<rows; ry++){ bgCtx.fillRect(0, ry*6+5, BG_W, 1); }
  // vigas de madera verticales
  bgCtx.fillStyle = '#2a1c12';
  for(let x=14; x<BG_W; x+=58){ bgCtx.fillRect(x,0,4,BG_H); }
  // viga horizontal superior
  bgCtx.fillStyle = '#3a2818';
  bgCtx.fillRect(0,0,BG_W,6);
  // estandarte del capítulo actual, con leve pulso de brillo
  const glow = 0.85 + Math.sin(t/600)*0.15;
  const bx = BG_W/2-9;
  bgCtx.globalAlpha = glow;
  bgCtx.fillStyle = ch.color;
  bgCtx.fillRect(bx,6,18,36);
  bgCtx.globalAlpha = 1;
  bgCtx.fillStyle = 'rgba(0,0,0,0.3)';
  bgCtx.fillRect(bx,6,18,4);
  bgCtx.fillStyle = '#1c130f';
  bgCtx.beginPath();
  bgCtx.moveTo(bx,42); bgCtx.lineTo(bx+9,50); bgCtx.lineTo(bx+18,42);
  bgCtx.fill();
  // partículas ambientales del capítulo (chispas/hojas/brasas según la materia)
  updateParticles(pal);
  // viñeta
  bgCtx.fillStyle = 'rgba(0,0,0,0.4)';
  bgCtx.fillRect(0,0,BG_W,8); bgCtx.fillRect(0,BG_H-8,BG_W,8);
  bgCtx.fillRect(0,0,10,BG_H); bgCtx.fillRect(BG_W-10,0,10,BG_H);
}
(function bgLoop(t){ drawCastleBG(t||0); requestAnimationFrame(bgLoop); })(0);

/* Cielo de la ventana: se interpola de forma fluida según el avance del
   jugador dentro del capítulo, y se mezcla suavemente hacia la paleta del
   próximo capítulo en el último tramo del actual (transición sin saltos). */
function updateWindowSky(){
  const idx = Math.max(0, chapterIndex(state.floor));
  const ch = CHAPTERS[idx];
  const pal = CHAPTER_PALETTES[ch.key];
  const nextCh = CHAPTERS[Math.min(idx+1, CHAPTERS.length-1)];
  const nextPal = CHAPTER_PALETTES[nextCh.key];
  const progress = (state.floor - ch.from) / Math.max(1, (ch.to-ch.from));
  const blend = idx < CHAPTERS.length-1 ? Math.max(0, (progress-0.7)/0.3) : 0;
  const bands = pal.sky.map((c,i)=> blend>0 ? lerpColor(c, nextPal.sky[i], blend*0.5) : c);
  const stops = [];
  bands.forEach((c,i)=>{
    const p0 = Math.round(i*100/bands.length);
    const p1 = Math.round((i+1)*100/bands.length);
    stops.push(`${c} ${p0}%`, `${c} ${p1}%`);
  });
  $('.window').style.background = `linear-gradient(180deg, ${stops.join(',')})`;
  const sun = document.querySelector('.window .sun');
  const glowColor = pal.particle;
  sun.style.top = (8+progress*70)+'%';
  sun.style.background = `radial-gradient(circle, #fff7d6, ${glowColor} 55%, transparent 75%)`;
  sun.style.boxShadow = `0 0 16px ${glowColor}`;
  document.documentElement.style.setProperty('--torch-glow', glowColor+'99');
}

