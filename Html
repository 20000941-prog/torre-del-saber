   ============================================================ */
/* Fisher-Yates real (in-place, sesgo uniforme) usado para barajar la cola de preguntas
   y también las opciones de puertas que se muestran al jugador. */
function fisherYatesShuffle(arr){
  const a = arr.slice();
  for(let i=a.length-1; i>0; i--){
    const j = Math.floor(Math.random()*(i+1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}
function shuffle(arr){ return fisherYatesShuffle(arr); }

/* Recorre un banco fijo (len/cie/soc) sin repetir preguntas hasta agotar el banco.
   state.usedQuestions[`${subject}_${tier}`] guarda una COLA ya barajada de IDs únicos
   (no índices temporales ni sólo el texto): cada item del pool recibe un __qid estable
   la primera vez que se ve. Al agotarse la cola se re-baraja (Fisher-Yates) todo el banco
   de nuevo, evitando que el primer ítem de la nueva cola repita la última pregunta mostrada. */
function pickUnique(pool, key, subject, tier){
  pool.forEach((item, i)=>{
    if(item.__qid===undefined) item.__qid = `${subject}_${tier}_${i}`;
  });
  const qKey = `${subject}_${tier}`;
  let queue = state.usedQuestions[qKey];
  if(!queue || queue.length===0){
    queue = fisherYatesShuffle(pool.map(item=>item.__qid));
    const last = state.lastQuestionKey[subject];
    if(queue.length>1 && queue[0]===last){
      const swapIdx = 1 + Math.floor(Math.random()*(queue.length-1));
      [queue[0], queue[swapIdx]] = [queue[swapIdx], queue[0]];
    }
    state.usedQuestions[qKey] = queue;
  }
  const qid = queue.shift();
  const item = pool.find(p=>p.__qid===qid);
  state.lastQuestionKey[subject] = qid;
  return item;
}

function buildMathRaw(grade){
  let a,b,c,x,k,base,pct,text,correct;
  if(grade===1){
    /* sumas y restas sencillas sin llevar, hasta 10 */
    const op = Math.random()<0.5 ? '+' : '-';
    a = Math.floor(Math.random()*9)+1; b = Math.floor(Math.random()*(a<9?9-0:9))+1;
    a = Math.floor(Math.random()*9)+1; b = Math.floor(Math.random()*9)+1;
    if(op==='-' && b>a){ const tmp=a; a=b; b=tmp; }
    correct = op==='+' ? a+b : a-b;
    text = `¿Cuánto es ${a} ${op} ${b}?`;
  } else if(grade===2){
    /* sumas y restas hasta 20, con llevada */
    const op = Math.random()<0.5 ? '+' : '-';
    a = Math.floor(Math.random()*15)+5; b = Math.floor(Math.random()*15)+1;
    if(op==='-' && b>a){ const tmp=a; a=b; b=tmp; }
    correct = op==='+' ? a+b : a-b;
    text = `¿Cuánto es ${a} ${op} ${b}?`;
  } else if(grade===3){
    /* tablas de multiplicar 2 a 5, sumas/restas hasta 100 */
    const type = Math.floor(Math.random()*2);
    if(type===0){ a=Math.floor(Math.random()*4)+2; b=Math.floor(Math.random()*9)+1; correct=a*b; text=`¿Cuánto es ${a} × ${b}?`; }
    else { a=Math.floor(Math.random()*60)+20; b=Math.floor(Math.random()*40)+10; const op=Math.random()<0.5?'+':'-'; if(op==='-'&&b>a){const t=a;a=b;b=t;} correct= op==='+'?a+b:a-b; text=`¿Cuánto es ${a} ${op} ${b}?`; }
  } else if(grade===4){
    /* tablas hasta 10 y división exacta sencilla */
    const type = Math.floor(Math.random()*2);
    if(type===0){ a=Math.floor(Math.random()*8)+2; b=Math.floor(Math.random()*8)+2; correct=a*b; text=`¿Cuánto es ${a} × ${b}?`; }
    else { b=Math.floor(Math.random()*7)+2; correct=Math.floor(Math.random()*9)+2; a=b*correct; text=`¿Cuánto es ${a} ÷ ${b}?`; }
  } else if(grade===5){
    /* multiplicación de dos cifras, división más grande, fracciones simples (mismo denominador) */
    const type = Math.floor(Math.random()*3);
    if(type===0){ a=Math.floor(Math.random()*40)+11; b=Math.floor(Math.random()*8)+2; correct=a*b; text=`¿Cuánto es ${a} × ${b}?`; }
    else if(type===1){ b=Math.floor(Math.random()*9)+2; correct=Math.floor(Math.random()*12)+3; a=b*correct; text=`¿Cuánto es ${a} ÷ ${b}?`; }
    else { const d=Math.floor(Math.random()*4)+3; const n1=Math.floor(Math.random()*(d-1))+1; const n2=Math.floor(Math.random()*(d-n1)); correct=n1+n2; text=`Si tienes ${n1}/${d} de pizza y comes ${n2}/${d} más, ¿cuántos ${d}avos tienes en total?`; }
  } else if(grade===6){
    /* porcentajes y decimales */
    const type = Math.floor(Math.random()*2);
    if(type===0){ base=Math.floor(Math.random()*80)+20; pct=[10,20,25,50,75][Math.floor(Math.random()*5)]; correct=Math.round(base*pct/100); text=`¿Cuánto es el ${pct}% de ${base}?`; }
    else { a=(Math.floor(Math.random()*90)+10)/10; b=(Math.floor(Math.random()*90)+10)/10; correct=Math.round((a+b)*10)/10; text=`¿Cuánto es ${a} + ${b}?`; }
  } else if(grade===7){
    /* números enteros (negativos) y ecuaciones simples x + k = total */
    const type = Math.floor(Math.random()*2);
    if(type===0){ a=Math.floor(Math.random()*20)-10; b=Math.floor(Math.random()*20)-10; correct=a+b; text=`¿Cuánto es (${a}) + (${b})?`; }
    else { x=Math.floor(Math.random()*25)+1; k=Math.floor(Math.random()*30)+5; correct=x; text=`Si x + ${k} = ${x+k}, ¿cuánto vale x?`; }
  } else if(grade===8){
    /* operaciones combinadas y ecuaciones de dos pasos */
    const type = Math.floor(Math.random()*2);
    if(type===0){ a=Math.floor(Math.random()*8)+2; b=Math.floor(Math.random()*8)+2; c=Math.floor(Math.random()*15)+1; correct=a*b+c; text=`¿Cuánto es (${a} × ${b}) + ${c}?`; }
    else { x=Math.floor(Math.random()*12)+1; k=Math.floor(Math.random()*5)+2; base=Math.floor(Math.random()*10)+3; correct=x; text=`Si ${k}x + ${base} = ${k*x+base}, ¿cuánto vale x?`; }
  } else {
    /* grado 9: ecuaciones lineales, porcentajes de aumento, geometría básica */
    const type = Math.floor(Math.random()*3);
    if(type===0){ x=Math.floor(Math.random()*15)+2; k=Math.floor(Math.random()*6)+2; c=Math.floor(Math.random()*20)+1; correct=x; text=`Si ${k}x - ${c} = ${k*x-c}, ¿cuánto vale x?`; }
    else if(type===1){ base=Math.floor(Math.random()*150)+50; pct=[10,15,20,25][Math.floor(Math.random()*4)]; correct=Math.round(base*(1+pct/100)); text=`Un producto de $${base} sube un ${pct}%. ¿Cuál es el nuevo precio?`; }
    else { a=Math.floor(Math.random()*12)+3; b=Math.floor(Math.random()*12)+3; correct=a*b; text=`¿Cuál es el área de un rectángulo de ${a} × ${b}?`; }
  }
  const distractors = new Set();
  while(distractors.size<2){
    const delta = (Math.floor(Math.random()*6)+1) * (Math.random()<0.5?-1:1);
    const val = correct+delta;
    if(val!==correct) distractors.add(val);
  }
  const options = shuffle([correct, ...distractors]);
  return {text, correct, options};
}

function makeMathQuestion(grade){
  /* Matemáticas se genera proceduralmente (no hay banco fijo), así que en vez de una cola
     barajada usamos un Set con el texto EXACTO de cada enunciado ya mostrado, indexado por
     grado, para no reciclar accidentalmente preguntas de otro grado. */
  const qKey = 'mat_'+grade;
  if(!state.usedQuestions[qKey]) state.usedQuestions[qKey] = new Set();
  const used = state.usedQuestions[qKey];
  const last = state.lastQuestionKey.mat;
  let result, attempts = 0;
  do{
    result = buildMathRaw(grade);
    attempts++;
  } while(attempts<20 && (used.has(result.text) || result.text===last));
  if(used.size>300) used.clear();
  used.add(result.text);
  state.lastQuestionKey.mat = result.text;
  return result;
}

