<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>La Torre del Saber</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Nunito:wght@400;600;700;800&display=swap');

  :root{
    --stone-1:#241c1a;
    --gold:#d9a441;
    --parchment:#f3e6cc;
    --parchment-dark:#e2d0ac;
    --good:#3f8f5f;
    --bad:#a13c3c;
    --c-math:#7b4fb0;
    --c-lang:#1f9d84;
    --c-sci:#3c9a52;
    --c-soc:#d9812f;
  }
  *{box-sizing:border-box;image-rendering:pixelated;}
  html,body{margin:0;height:100%;background:var(--stone-1);overflow:hidden;font-family:'Nunito',sans-serif;color:var(--parchment);}
  #app{position:relative;width:100vw;height:100vh;overflow:hidden;}

  /* ---------- Castle background (pixel canvas) ---------- */
  #bg-canvas{position:absolute;inset:0;z-index:0;width:100vw;height:100vh;image-rendering:pixelated;}
  #tower-bg{position:absolute;inset:0;z-index:1;pointer-events:none;}
  #tower-bg::after{content:"";position:absolute;inset:0;
    background:radial-gradient(ellipse at 50% 45%, transparent 25%, rgba(0,0,0,0.5) 100%);}
  .window{position:absolute;top:8%;right:6%;width:180px;height:240px;border-radius:0;
    box-shadow:inset 0 0 0 8px #1c130f, 0 0 30px rgba(0,0,0,0.6);
    transition:background 1s steps(1);overflow:hidden;}
  .window .sun{position:absolute;width:26px;height:26px;left:50%;margin-left:-13px;
    transition:top 1s ease, background 1s ease, box-shadow 1s ease;}
  .torch{position:absolute;width:12px;height:26px;bottom:0;
    background:var(--gold);animation:flicker 1.4s infinite steps(4);
    box-shadow:0 0 14px var(--torch-glow, rgba(244,169,74,0.6));transition:box-shadow 1s ease;}
  .torch::before{content:"";position:absolute;left:3px;bottom:-16px;width:4px;height:18px;background:#2b1c13;}
  @keyframes flicker{0%,100%{background:#f4a94a;height:26px;}25%{background:#ffcf7a;height:22px;}
    50%{background:#e08a2e;height:28px;}75%{background:#ffd98f;height:24px;}}
  .torch.tl{top:14%;left:6%;} .torch.bl{bottom:16%;left:9%;}

  /* ---------- HUD ---------- */
  #hud{position:absolute;top:0;left:0;right:0;z-index:5;display:none;align-items:center;justify-content:space-between;
    padding:14px 22px;font-weight:700;letter-spacing:0.5px;
    background:linear-gradient(180deg, rgba(10,7,6,0.75), transparent);pointer-events:none;}
  #hud.show{display:flex;}
  #hud .chip{background:rgba(20,14,11,0.6);border:1px solid rgba(217,164,65,0.4);border-radius:6px;padding:6px 14px;font-size:12px;color:var(--gold);font-family:'Press Start 2P',monospace;}
  #hud .floorlabel{font-family:'Press Start 2P',monospace;font-size:14px;color:var(--parchment);text-shadow:0 2px 0 rgba(0,0,0,0.8);}
  #hud .floorlabel small{display:block;font-family:'Nunito',sans-serif;font-weight:700;font-size:10px;letter-spacing:1.5px;color:var(--gold);text-transform:uppercase;margin-bottom:4px;}

  #screen{position:absolute;inset:0;z-index:2;display:flex;align-items:center;justify-content:center;padding:24px;overflow:auto;}

  .panel{max-width:920px;width:100%;text-align:center;animation:rise 0.5s ease;}
  @keyframes rise{from{opacity:0;transform:translateY(18px);}to{opacity:1;transform:translateY(0);}}

  h1.title{font-family:'Press Start 2P',monospace;font-weight:400;font-size:clamp(16px,3vw,28px);color:var(--gold);
    text-shadow:0 0 14px rgba(217,164,65,0.5), 3px 3px 0 rgba(0,0,0,0.8);margin:0 0 14px;line-height:1.5;}
  p.sub{color:var(--parchment-dark);font-size:15px;margin:0 0 26px;}

  .cards{display:flex;gap:22px;justify-content:center;flex-wrap:wrap;}
  .card{background:linear-gradient(160deg, rgba(58,44,34,0.9), rgba(30,22,17,0.92));
    border:3px solid rgba(217,164,65,0.35);border-radius:4px;padding:20px;width:220px;cursor:pointer;
    transition:transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;}
  .card:hover{transform:translateY(-6px);border-color:var(--gold);box-shadow:0 12px 0 rgba(0,0,0,0.4);}
  .card h3{font-family:'Press Start 2P',monospace;color:var(--parchment);margin:14px 0 8px;font-size:13px;}
  .card p{color:var(--parchment-dark);font-size:13px;margin:0;line-height:1.4;}

  .pixel-frame{margin:0 auto;display:flex;align-items:center;justify-content:center;
    background:rgba(0,0,0,0.25);border:3px solid rgba(217,164,65,0.4);border-radius:4px;padding:6px;width:fit-content;}

  .door{width:150px;height:220px;border-radius:0;cursor:pointer;position:relative;
    background:linear-gradient(180deg, #6b4a2e, #4a2f1c);border:4px solid #2c1c10;
    box-shadow:inset 0 0 0 6px rgba(217,164,65,0.15), 0 10px 0 rgba(0,0,0,0.5);
    transition:transform 0.15s ease, box-shadow 0.15s ease;}
  .door:hover{transform:translateY(-8px);box-shadow:0 0 0 3px var(--gold), 0 16px 0 rgba(0,0,0,0.5);}
  .door .knob{position:absolute;width:10px;height:10px;background:var(--gold);right:16px;top:50%;box-shadow:0 0 6px rgba(217,164,65,0.8);}
  .door .label{position:absolute;bottom:14px;left:0;right:0;text-align:center;font-family:'Press Start 2P',monospace;font-weight:400;color:var(--parchment);font-size:11px;text-shadow:0 2px 0 rgba(0,0,0,0.7);padding:0 6px;}
  .doors-row{display:flex;gap:34px;justify-content:center;flex-wrap:wrap;}

  .guide-box{display:flex;gap:16px;align-items:center;text-align:left;background:rgba(20,14,11,0.85);
    border:3px solid rgba(217,164,65,0.35);border-radius:4px;padding:16px 20px;margin-bottom:24px;max-width:760px;margin-left:auto;margin-right:auto;}
  .guide-name{font-family:'Press Start 2P',monospace;font-weight:400;font-size:12px;margin-bottom:6px;}
  .guide-text{font-size:14px;line-height:1.5;color:var(--parchment);}

  .question-text{font-family:'Press Start 2P',monospace;font-size:clamp(13px,2vw,18px);line-height:1.8;color:var(--parchment);margin-bottom:30px;
    background:rgba(20,14,11,0.55);border-radius:4px;padding:16px 24px;display:inline-block;border:2px solid rgba(217,164,65,0.3);}

  .q-timer{font-family:'Press Start 2P',monospace;font-size:14px;color:var(--gold);background:rgba(20,14,11,0.6);
    border:2px solid rgba(217,164,65,0.4);border-radius:6px;padding:8px 16px;display:block;width:fit-content;margin:0 auto 18px;
    transition:color .2s ease, border-color .2s ease;}
  .q-timer.urgent{color:#ff9a8f;border-color:var(--bad);animation:flicker 0.6s infinite steps(2);}

  .hint-btn{font-family:'Press Start 2P',monospace;font-weight:400;background:transparent;color:var(--gold);
    border:2px solid rgba(217,164,65,0.5);border-radius:4px;padding:10px 16px;font-size:10px;cursor:pointer;
    margin-top:22px;transition:transform .12s ease, background .12s ease;}
  .hint-btn:hover:not(:disabled){background:rgba(217,164,65,0.15);transform:translateY(-2px);}
  .hint-btn:disabled{opacity:0.3;cursor:not-allowed;}

  .door.discarded{opacity:0.22;pointer-events:none;filter:grayscale(1);transform:none !important;}

  /* ---------- Zona de descanso (rest area) ---------- */
  .rest-panel{max-width:640px;}
  .rest-scene-frame{width:240px;height:80px;margin:0 auto 18px;border:3px solid rgba(217,164,65,0.35);
    border-radius:4px;overflow:hidden;background:rgba(10,7,6,0.4);}
  .rest-scene-frame canvas{width:100%;height:100%;image-rendering:pixelated;}
  .rest-actions{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-top:8px;}
  .shop-box{margin-top:22px;padding-top:18px;border-top:2px dashed rgba(217,164,65,0.3);}
  .shop-title{font-family:'Press Start 2P',monospace;font-size:12px;color:var(--gold);margin-bottom:12px;}
  .shop-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;}
  .shop-card{background:rgba(20,14,11,0.55);border:2px solid rgba(217,164,65,0.3);border-radius:6px;
    padding:12px;display:flex;flex-direction:column;gap:8px;align-items:center;text-align:center;}
  .shop-card-name{font-family:'Press Start 2P',monospace;font-size:10px;color:var(--parchment);}
  .shop-card-desc{font-size:12px;color:rgba(244,233,216,0.75);line-height:1.4;}
  .shop-buy-btn{font-size:11px;padding:8px 14px;margin-top:auto;}
  button.action.heal-btn{background:var(--good);border-bottom-color:#1f5a38;color:#eafff2;}
  button.action:disabled{opacity:0.45;cursor:not-allowed;transform:none !important;}

  button.action{font-family:'Press Start 2P',monospace;font-weight:400;background:var(--gold);
    color:#241a0d;border:none;border-bottom:4px solid #a67623;border-radius:4px;padding:14px 22px;font-size:12px;cursor:pointer;
    transition:transform 0.12s ease;}
  button.action:hover{transform:translateY(-3px);}

  .flash-correct, .flash-wrong{position:fixed;inset:0;z-index:20;display:flex;align-items:center;justify-content:center;
    font-family:'Press Start 2P',monospace;font-size:28px;font-weight:400;pointer-events:none;opacity:0;}
  .flash-correct{color:#8ff0b0;text-shadow:3px 3px 0 #123a24;}
  .flash-wrong{color:#ff9a8f;text-shadow:3px 3px 0 #4a1a1a;}
  .flash-correct.on, .flash-wrong.on{animation:flashpop 0.85s ease forwards;}
  @keyframes flashpop{0%{opacity:0;transform:scale(0.7);}30%{opacity:1;transform:scale(1.05);}70%{opacity:1;}100%{opacity:0;transform:scale(1.1);}}

  #boss-canvas{position:absolute;inset:0;z-index:3;cursor:crosshair;}
  .bossbar-wrap{position:absolute;top:64px;left:50%;transform:translateX(-50%);width:60%;max-width:520px;z-index:6;text-align:center;}
  .bossbar{height:16px;background:rgba(0,0,0,0.5);border:3px solid rgba(217,164,65,0.5);overflow:hidden;}
  .bossbar-fill{height:100%;background:#c0392b;width:100%;transition:width 0.2s steps(10);}
  .bossname{font-family:'Press Start 2P',monospace;color:var(--gold);margin-bottom:8px;font-size:12px;text-shadow:2px 2px 0 rgba(0,0,0,0.8);}
  .playerhp{position:absolute;bottom:26px;left:50%;transform:translateX(-50%);display:flex;gap:6px;z-index:6;}
  .boss-hint{position:absolute;bottom:60px;left:50%;transform:translateX(-50%);z-index:6;color:var(--parchment-dark);font-size:12px;font-family:'Press Start 2P',monospace;}

  #cutscene{position:absolute;inset:0;z-index:30;background:#161010;display:flex;align-items:center;justify-content:center;overflow:hidden;}
  #ending-canvas{position:absolute;inset:0;width:100%;height:100%;z-index:0;image-rendering:pixelated;}
  .runner{position:absolute;bottom:20%;left:8%;z-index:2;transition:left 3.4s cubic-bezier(.3,.6,.4,1), bottom 3.4s ease, opacity 1s ease 2.8s;filter:drop-shadow(0 4px 3px rgba(0,0,0,0.5));}
  .stats-box{position:relative;z-index:3;text-align:center;color:#f3e6cc;opacity:0;transition:opacity 1s ease;background:rgba(20,14,11,0.72);border:3px solid rgba(217,164,65,0.5);border-radius:6px;padding:26px 34px;}
  .stats-box.show{opacity:1;}
  .stats-box h1{font-family:'Press Start 2P',monospace;font-size:20px;color:var(--gold);line-height:1.6;text-shadow:2px 2px 0 rgba(0,0,0,0.6);}
  .stats-box .stat{font-size:16px;font-weight:700;margin:8px 0;color:#f3e6cc;}

  @media (max-width:640px){
    .window{width:110px;height:150px;right:4%;}
    .door{width:110px;height:170px;}
    .cards{gap:14px;}
    .card{width:150px;padding:14px;}
  }
</style>
</head>
<body>
<div id="app">
  <canvas id="bg-canvas"></canvas>
  <div id="tower-bg">
    <div class="window"><div class="sun"></div></div>
    <div class="torch tl"></div>
    <div class="torch bl"></div>
  </div>

  <div id="hud">
    <div style="display:flex;gap:10px;align-items:center;">
      <div class="chip" id="hud-mistakes">ERRORES: 0</div>
      <div class="chip" id="hud-streak">RACHA: 0</div>
      <div class="chip" id="hud-points">⭐ 0</div>
    </div>
    <div class="floorlabel" id="hud-floor"><small id="hud-chapter">CAPITULO</small>PISO 1</div>
    <div style="display:flex;gap:10px;align-items:center;">
      <div class="chip" id="hud-time">00:00</div>
      <div class="chip" id="hud-pause" style="cursor:pointer;pointer-events:auto;">☰ MENÚ</div>
    </div>
  </div>

  <div id="screen"></div>
  <canvas id="boss-canvas" style="display:none;"></canvas>
  <div class="flash-correct" id="flash-correct">CORRECTO</div>
  <div class="flash-wrong" id="flash-wrong">FALLASTE</div>
</div>

<script>
/* ============================================================
   LA TORRE DEL SABER — motor del juego (single file, estilo pixel)
   ============================================================ */

const $ = sel => document.querySelector(sel);
const screenEl = $('#screen');

/* ============================================================
   SPRITES PIXEL — plantilla compartida, colores por personaje
   ============================================================ */
function buildSprite(hat, body, face, eye, outline, collar, boots){
  outline = outline || '#1a120c';
  collar = collar || '#3a2a1a';
  boots = boots || '#1a120c';
  const half = [
    '....XX..',
    '...XAAX.',
    '..XAAAAX',
    '..XFFFFX',
    '..XFEFEX',
    '..XFFFFX',
    '...BBBB.',
    '..CCCCCC',
    '..CC..CC',
    '..DD..DD',
  ];
  return {half, palette:{X:outline,A:hat,F:face,E:eye,B:collar,C:body,D:boots}};
}

function drawSprite(ctx, sprite, x, y, scale){
  sprite.half.forEach((row,r)=>{
    const full = row + row.split('').reverse().join('');
    for(let c=0;c<full.length;c++){
      const ch = full[c];
      if(ch==='.') continue;
      ctx.fillStyle = sprite.palette[ch];
      ctx.fillRect(x + c*scale, y + r*scale, scale, scale);
    }
  });
}

function spriteToCanvas(sprite, scale){
  const width = 16*scale, height = 10*scale;
  const c = document.createElement('canvas');
  c.width = width; c.height = height;
  c.style.width = width+'px'; c.style.height = height+'px';
  c.style.imageRendering = 'pixelated';
  const ctx = c.getContext('2d');
  ctx.imageSmoothingEnabled = false;
  drawSprite(ctx, sprite, 0, 0, scale);
  return c;
}

/* ---------------- Personajes jugables ---------------- */
const CHARACTERS = [
  {
    id:'kael', name:'Kael', color:'#c0392b',
    desc:'Guerrero disciplinado de la Orden de la Torre. Golpe lento pero contundente.',
    sprite: buildSprite('#7a1f1f','#c0392b','#e8b988','#241a0d')
  },
  {
    id:'nova', name:'Nova', color:'#2e86de',
    desc:'Exploradora ágil con instinto para los enigmas. Dispara rápido y en ráfagas.',
    sprite: buildSprite('#123a63','#2e86de','#f1c8a5','#241a0d')
  }
];

/* ---------------- Guías / jefes por materia ---------------- */
const CHAPTERS = [
  {key:'mat', name:'Matemáticas', guideName:'Enigma', color:'#7b4fb0', from:1, to:10},
  {key:'len', name:'Lenguaje',    guideName:'Amci',   color:'#1f9d84', from:11, to:20},
  {key:'cie', name:'Ciencias',    guideName:'Bio, de Mi Cerro', color:'#3c9a52', from:21, to:30},
  {key:'soc', name:'Sociales',    guideName:'Cosmic Lord', color:'#d9812f', from:31, to:40},
];
function chapterForFloor(f){ return CHAPTERS.find(c=>f>=c.from && f<=c.to) || CHAPTERS[CHAPTERS.length-1]; }
function chapterIndex(f){ return CHAPTERS.findIndex(c=>f>=c.from && f<=c.to); }

/* ---------------- Definición de jefes (personaje + ataques + vida) ---------------- */
/* ============================================================
   IA DE JEFES — utilidades reutilizables de patrones de ataque
   ============================================================
   Cada jefe arma su set de ataques combinando estas piezas. Los patrones
   avanzados se activan según la FASE del combate (según % de vida restante),
   así el combate escala en intensidad sin tener que rehacer cada jefe desde
   cero, y sin sorpresas injustas: todo ataque de área o embestida se avisa
   antes de hacer daño (telegraph). */

/* Fase 1: 100%-66% hp (patrón base) · Fase 2: 66%-33% hp (suma AoE telegrafiada)
   · Fase 3: <33% hp ("enrage": cadencia mayor + mecánica especial del jefe). */
function bossPhase(b){
  const pct = b.hp / b.maxHp;
  if(pct > 0.66) return 1;
  if(pct > 0.33) return 2;
  return 3;
}

/* Abanico de N proyectiles centrado en un ángulo base — patrón compartido
   por casi todos los jefes para no repetir la misma lógica de tiro. */
function fanShot(b, baseAngle, count, spread, speed, color, size, t){
  const start = -spread*(count-1)/2;
  for(let i=0;i<count;i++){
    const off = start + i*spread;
    b.bossBullets.push({x:b.bx, y:b.by, vx:Math.cos(baseAngle+off)*speed, vy:Math.sin(baseAngle+off)*speed, color, size, spawnTime:t});
  }
}

/* Ataque de ÁREA TELEGRAFIADO: primero muestra un aviso (círculo pulsante, ver
   drawTelegraphs) durante `warnMs` para dar tiempo real de reacción, y sólo
   entonces libera un anillo de proyectiles en 360°. Nunca golpea a traición.
   Se activa a partir de la fase 2. */
function telegraphedRingBurst(b, t, key, cooldown, warnMs, count, speed, color, size){
  const readyAt = b.timers[key+'_next'] || 0;
  if(t < readyAt) return;
  if(!b.timers[key+'_warnStart']){
    b.timers[key+'_warnStart'] = t;
    b.telegraphs.push({x:()=>b.bx, y:()=>b.by, start:t, duration:warnMs, color});
    return;
  }
  if(t - b.timers[key+'_warnStart'] >= warnMs){
    for(let i=0;i<count;i++){
      const ang = (Math.PI*2/count)*i;
      b.bossBullets.push({x:b.bx, y:b.by, vx:Math.cos(ang)*speed, vy:Math.sin(ang)*speed, color, size, spawnTime:t});
    }
    b.timers[key+'_next'] = t + cooldown;
    b.timers[key+'_warnStart'] = null;
  }
}

/* EMBESTIDA telegrafiada: el jefe avisa (telegraph rojo + sacudida visual) y luego
   se desliza rápido hacia la posición X del jugador; al llegar libera una ráfaga
   concentrada de corto alcance. Sólo fase 3 (enrage), para jefes de "duelo directo". */
function chargeDash(b, t, key, cooldown, warnMs, dashMs){
  const readyAt = b.timers[key+'_next'] || 0;
  if(t < readyAt) return;
  if(!b.timers[key+'_warnStart']){
    b.timers[key+'_warnStart'] = t;
    b.charging = true;
    b.dashFromX = b.bx;
    b.dashToX = Math.max(60, Math.min(b.canvas.width-60, b.px));
    b.telegraphs.push({x:()=>b.bx, y:()=>b.by, start:t, duration:warnMs, color:'#ff4d4d'});
    return;
  }
  const elapsed = t - b.timers[key+'_warnStart'];
  if(elapsed < warnMs) return; // sigue en telegraph — el sprite se sacude en bossLoop
  if(elapsed < warnMs+dashMs){
    const progress = (elapsed-warnMs)/dashMs;
    b.bx = b.dashFromX + (b.dashToX-b.dashFromX)*progress;
    return;
  }
  fanShot(b, Math.atan2(b.py-b.by, b.px-b.bx), 5, 0.18, 5.4, '#ffffff', 9, t);
  b.charging = false;
  b.timers[key+'_next'] = t + cooldown;
  b.timers[key+'_warnStart'] = null;
}

/* INVOCACIÓN: crea secuaces temporales que orbitan al jefe y disparan proyectiles
   lentos. A diferencia de la primera versión, ahora SÍ tienen una vida propia
   pequeña (mueren si el jugador les dispara lo suficiente) y muestran su propia
   barra de vida flotante — igual que los enemigos individuales con nombre y
   barra de vida del video de referencia. También expiran solos tras `life` ms
   si no mueren antes. */
function summonMinions(b, t, key, cooldown, count, life, color){
  const readyAt = b.timers[key+'_next'] || 0;
  if(t < readyAt) return;
  for(let i=0;i<count;i++){
    b.minions.push({angle:(Math.PI*2/count)*i, born:t, life, color, lastShot:0, hp:18, maxHp:18, x:b.bx, y:b.by});
  }
  b.timers[key+'_next'] = t + cooldown;
}
function updateMinions(b, t, ctx){
  b.minions = b.minions.filter(m=>{
    const age = t-m.born;
    if(age>m.life || m.hp<=0) return false;
    const orbitR = 90;
    const ang = m.angle + t/900;
    m.x = b.bx + Math.cos(ang)*orbitR; m.y = b.by + Math.sin(ang)*orbitR + 40;
    ctx.fillStyle = m.color;
    ctx.beginPath(); ctx.arc(m.x, m.y, 10, 0, Math.PI*2); ctx.fill();
    // barra de vida flotante propia del secuaz (fiel al HUD de enemigos del video de referencia)
    ctx.fillStyle = 'rgba(0,0,0,0.55)'; ctx.fillRect(m.x-16, m.y-20, 32, 4);
    ctx.fillStyle = m.color; ctx.fillRect(m.x-16, m.y-20, 32*Math.max(0,m.hp/m.maxHp), 4);
    if(t-m.lastShot>1400){
      m.lastShot = t;
      const shotAngle = Math.atan2(b.py-m.y, b.px-m.x);
      b.bossBullets.push({x:m.x, y:m.y, vx:Math.cos(shotAngle)*2.6, vy:Math.sin(shotAngle)*2.6, color:m.color, size:7, spawnTime:t});
    }
    return true;
  });
}

/* CONTRAATAQUE: si el jugador conecta 3 golpes en menos de 600ms (combo agresivo),
   el jefe responde con UN disparo rápido apuntado. Premia el buen ritmo y castiga el
   spam sin filtro, pero siempre es un solo proyectil legible — nunca un pico injusto.
   Sólo los jefes con `def.counter===true` lo usan (ver bossLoop). */
function registerPlayerHit(b, t){
  b.recentHits = (b.recentHits||[]).filter(h=>t-h<600);
  b.recentHits.push(t);
}
function maybeCounter(b, t){
  if((b.recentHits||[]).length>=3 && (!b.timers.counter_next || t>b.timers.counter_next)){
    const ang = Math.atan2(b.py-b.by, b.px-b.bx);
    b.bossBullets.push({x:b.bx, y:b.by, vx:Math.cos(ang)*6.2, vy:Math.sin(ang)*6.2, color:'#ff4d4d', size:9, spawnTime:t});
    b.timers.counter_next = t + 1800; // no puede contraatacar más de una vez cada 1.8s
    b.recentHits = [];
  }
}

