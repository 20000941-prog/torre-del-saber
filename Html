/* ---------------- Generador de preguntas: SOLO opción múltiple ----------------
   Todas las preguntas se resuelven eligiendo una de las puertas. Se eliminó el
   modo de respuesta abierta (campo de texto) junto con su normalización y su
   heurística de "aptitud para escribir": un único formato mantiene el ritmo
   del juego constante y evita validaciones ambiguas de texto libre. */
function generateQuestionFor(chapterKey, tier){
  if(chapterKey==='mat'){
    const q = makeMathQuestion(tier);
    return {text:q.text, correct:String(q.correct), options:q.options.map(String)};
  }
  const pools = {len:LANG_POOL, cie:SCI_POOL, soc:SOC_POOL}[chapterKey];
  const item = pickUnique(pools[tier], 'q', chapterKey, tier);
  return {text:item.q, correct:item.correct, options:shuffle(item.opts)};
}

